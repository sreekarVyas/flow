# Copy to .env (git-ignored). All values have local defaults.
POSTGRES_PASSWORD=flow_local
DATABASE_URL=postgresql+psycopg://flow:flow_local@127.0.0.1:5432/flow
TEST_DATABASE_URL=postgresql+psycopg://flow:flow_local@127.0.0.1:5432/flow_test
# JSON list. Only mail from these exact addresses is stored.
ALERT_SENDERS=["alerts@hdfcbank.bank.in","onlinesbicard@sbicard.com"]
BACKFILL_START=2026-11-01
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=600
# Personal patterns for kind rules (JSON lists, as the bank prints names).
SELF_NAMES=["YOUR NAME AS BANK SHOWS IT"]
SALARY_PAYERS=["YOUR EMPLOYER"]
